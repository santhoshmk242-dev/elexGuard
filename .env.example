# Copy to backend/.env and fill in. NEVER commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/elexguard for a local MongoDB)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/elexguard?retryWrites=true&w=majority

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
OTP_HASH_SECRET=
JWT_EXPIRES_IN=2h

# Frontend origin(s) allowed by CORS (comma separated, no trailing slash)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Gmail SMTP (use a Gmail *App Password*, not your normal password – see README)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
EMAIL_FROM=ElexGuard <your.address@gmail.com>

# OTP policy
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Account lockout / ballot session
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
BALLOT_TOKEN_TTL_MINUTES=15

# Set to 1 when deployed behind a proxy (Render, Vercel rewrites). Leave unset locally.
# TRUST_PROXY=1
